{
  "name": "terrarium-playground",
  "version": "0.8.0-dev.s2",
  "private": true,
  "description": "A browser-local playground for independent Linux machines, agent tasks, and network experiments.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run runtime:prepare",
    "dev": "vite --host 0.0.0.0",
    "runtime:prepare": "node scripts/prepare-runtime.mjs && node scripts/prepare-tinyemu.mjs && node scripts/prepare-qemu.mjs",
    "prebuild": "npm run runtime:prepare",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 --test-reporter=tap src/lib/*.test.ts",
    "test:vm": "node --experimental-strip-types scripts/smoke-vm.mjs",
    "test:bridge": "node --experimental-strip-types scripts/smoke-bridge.mjs",
    "test:workspace": "node --experimental-strip-types scripts/smoke-workspace.mjs",
    "test:dns": "node --experimental-strip-types scripts/smoke-dns.mjs",
    "test:evidence": "node --experimental-strip-types scripts/smoke-evidence.mjs",
    "test:rv64": "node --experimental-strip-types scripts/smoke-rv64.mjs",
    "test:network": "node --experimental-strip-types scripts/smoke-network.mjs",
    "test:vpc": "node --experimental-strip-types scripts/smoke-vpc.mjs",
    "test:profiles": "node --experimental-strip-types scripts/smoke-profiles.mjs",
    "test:volume": "node --experimental-strip-types scripts/smoke-volume.mjs",
    "test:cloud": "node --experimental-strip-types scripts/smoke-cloud.mjs",
    "test:lifecycle": "node --experimental-strip-types scripts/smoke-lifecycle.mjs",
    "test:recovery": "node --experimental-strip-types scripts/smoke-recovery.mjs",
    "test:qemu": "node --experimental-strip-types scripts/smoke-qemu.mjs",
    "test:qemu-storage": "node --experimental-strip-types scripts/smoke-qemu-storage.mjs",
    "test:qemu-network": "node --experimental-strip-types scripts/smoke-qemu-network.mjs",
    "test:browser": "node scripts/browser/smoke-s1.mjs",
    "test:browser:failures": "node scripts/browser/smoke-s1.mjs --mode=failures",
    "runtime:cache:qemu": "node scripts/cache-qemu-assets.mjs",
    "source:manifest": "node scripts/source-manifest.mjs create",
    "source:verify": "node scripts/source-manifest.mjs verify",
    "test:fixtures:recorded": "node scripts/run-unit-fixtures.mjs",
    "test:browser:s2:helper": "node scripts/browser/build-s2-harness.mjs",
    "test:browser:s2:migrations": "node scripts/browser/smoke-s2.mjs --mode=migrations",
    "test:browser:s2:quota": "node scripts/browser/smoke-s2.mjs --mode=quota",
    "test:browser:s2:storage": "node scripts/browser/smoke-s2.mjs --mode=storage",
    "test:browser:s2:presets": "node scripts/browser/smoke-s2.mjs --mode=presets",
    "test:browser:s2:persistence": "node scripts/browser/smoke-s2.mjs --mode=persistence",
    "test:browser:s2:images": "node scripts/prepare-s2-image-fixture.mjs && node scripts/browser/smoke-s2.mjs --mode=images",
    "test:browser:s2:ui": "node scripts/browser/smoke-s2.mjs --mode=ui"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "0.546.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "v86": "0.5.472",
    "vite": "8.3.5"
  },
  "author": "Niklas Olsson",
  "homepage": "https://niklas-olsson.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/niklas-olsson/niklas-olsson.github.io.git"
  }
}
