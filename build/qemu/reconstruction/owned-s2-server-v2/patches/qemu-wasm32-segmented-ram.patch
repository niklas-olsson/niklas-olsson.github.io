+#if defined(EMSCRIPTEN)
+/* The fixed Wasm PC server uses two separately allocated 1 GiB RAMBlocks.
+ * Keep each mmap below libc's PTRDIFF_MAX limit and cap the aggregate at 2 GiB.
+ * This is not permission to allocate a single larger mapping or hotplug RAM. */
+static bool wasm_segmented_pc_ram_supported(MachineState *machine)
+{
+    MachineClass *mc = MACHINE_GET_CLASS(machine);
+    NumaState *numa = machine->numa_state;
+    if (!mc->family || strcmp(mc->family, "pc_piix") != 0 ||
+        machine->ram_size != 2 * GiB ||
+        machine->maxram_size != machine->ram_size || machine->ram_slots ||
+        machine->smp.cpus != 2 || machine->smp.max_cpus != 2 ||
+        machine->memdev || !numa || numa->num_nodes != 2 ||
+        numa_uses_legacy_mem()) {
+        return false;
+    }
+    for (int i = 0; i < 2; i++) {
+        NodeInfo *node = &numa->nodes[i];
+        if (!node->present || node->node_mem != GiB || !node->node_memdev ||
+            strcmp(object_get_typename(OBJECT(node->node_memdev)),
+                   TYPE_MEMORY_BACKEND_RAM) != 0 ||
+            memory_region_size(host_memory_backend_get_memory(node->node_memdev)) != GiB) {
+            return false;
+        }
+    }
+    return numa->nodes[0].node_memdev != numa->nodes[1].node_memdev;
+}
+#endif
